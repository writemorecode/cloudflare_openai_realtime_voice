{
  "name": "@ai-oral-exam/livekit-agent",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run test",
    "console": "lk agent console src/main.ts",
    "dev": "lk agent dev src/main.ts",
    "start": "node dist/main.js start",
    "test": "vitest run --config vitest.config.ts",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@livekit/agents": "^1.5.2",
    "@livekit/agents-plugin-openai": "^1.5.2",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
