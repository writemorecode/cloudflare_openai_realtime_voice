OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Required only when running against LiveKit Cloud locally. LiveKit Cloud injects these in deployments.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Explicitly permits synthetic dispatch metadata for local console use.
AGENT_ALLOW_SYNTHETIC_METADATA=false

# Required for dispatched jobs; optional only for explicitly synthetic console jobs.
AGENT_CONTROL_PLANE_URL=http://localhost:8787
AGENT_CALLBACK_TOKEN=
