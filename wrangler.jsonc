{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oai-cf-realtime",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"],
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://oai-cf-realtime.gustav-ae-karlsson.workers.dev/",
    "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1",
    "OPENAI_REALTIME_VOICE": "marin",
  },
  "secrets": {
    "required": ["CONVERSATION_ID_SECRET", "OPENAI_API_KEY"],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONVERSATION_SESSIONS",
        "class_name": "ConversationSession",
      },
    ],
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "oral-exam-auth",
      "database_id": "1af84547-3ebc-4914-bdd8-f6ea7b0e7275",
      "migrations_dir": "migrations",
    },
    {
      "binding": "EXAM_DB",
      "database_name": "oral-exam-data-dev",
      "database_id": "cad009b8-5c4c-4d6a-ab67-8d73a788adff",
      "migrations_dir": "migrations-examinations",
    },
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ConversationSession"],
    },
  ],
  "r2_buckets": [
    {
      "bucket_name": "oral-exam-recordings-dev",
      "binding": "RECORDINGS",
      "remote": true,
    },
  ],
}
