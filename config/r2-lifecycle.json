{
  "rules": [
    {
      "id": "delete-all-recordings-after-30-days",
      "enabled": true,
      "conditions": {},
      "deleteObjectsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 2592000
        }
      },
      "abortMultipartUploadsTransition": {
        "condition": {
          "type": "Age",
          "maxAge": 86400
        }
      }
    }
  ]
}
