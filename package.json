{
  "name": "oai-cf-realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "vite build",
    "auth:create-user": "node scripts/create-d1-user.mjs",
    "auth:change-password": "node scripts/change-d1-user-password.mjs",
    "dev": "vite",
    "check": "pnpm run typecheck && pnpm run test:boundaries && pnpm run test:auth-scripts && pnpm run test",
    "test": "vitest run --config vitest.config.ts && vitest run --config web/vitest.config.ts",
    "test:foundation": "vitest run --config vitest.config.ts test/conversation-http-api.test.ts test/conversation-session.test.ts",
    "test:auth-scripts": "node --test scripts/auth-user-utils.test.mjs",
    "test:boundaries": "node --test scripts/application-boundary.test.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "types": "wrangler types",
    "fmt": "pnpm exec oxfmt",
    "lint": "pnpm exec oxlint",
    "r2:apply-retention": "wrangler r2 bucket lifecycle set oral-exam-recordings-dev --file config/r2-lifecycle.json --force",
    "r2:verify-retention": "wrangler r2 bucket lifecycle list oral-exam-recordings-dev"
  },
  "dependencies": {
    "@ai-oral-exam/conversation-client": "workspace:*",
    "@ai-oral-exam/conversation-contract": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "better-result": "3.0.0",
    "hono": "^4.12.32",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-plugin-eslint": "^1.77.0",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "packageManager": "pnpm@11.16.0"
}
