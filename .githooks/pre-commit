#!/bin/sh
set -e

cd "$(git rev-parse --show-toplevel)"

files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cjs|cts|js|json|jsonc|jsx|mjs|mts|ts|tsx)$' || true)

if [ -z "$files" ]; then
  echo "No staged JS/TS/config files to check."
  exit 0
fi

pnpm exec oxfmt --check $files

lint_files=$(printf '%s\n' "$files" | grep -E '\.(cjs|cts|js|jsx|mjs|mts|ts|tsx)$' || true)

if [ -n "$lint_files" ]; then
  pnpm exec oxlint $lint_files
fi

npx slop-scan scan . --lint
